# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Production API: do not put server-side secrets in VITE_ variables.
DATABASE_URL=postgresql://cobraflux:change-me@localhost:5432/cobraflux
DATABASE_SSL=disable
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
PORT=8080
TRUST_PROXY=false
# Verified sender and Resend key are mandatory to register users in production.
# Use an email from a verified sender domain. Never publish real credentials.
RESEND_API_KEY=
RESET_EMAIL_FROM=
# Generate offline with: openssl rand -hex 32
MFA_ENCRYPTION_KEY=
# One-time admin enrollment: fill only on a trusted operator machine/shell.
ADMIN_USER_EMAIL=
# Production frontend mode is enabled explicitly after deployment and tests:
# VITE_APP_MODE=production

# Phase 3 sandbox only: encrypt separate credentials for each organization's Asaas test account.
# Required for sandbox connection; use: openssl rand -hex 32
# Never store the master key in Git, localStorage or VITE_ variables.
PAYMENT_CREDENTIAL_ENCRYPTION_KEY=
# Provider endpoint is permanently pinned in code to https://api-sandbox.asaas.com/v3
# Per-organization API keys and webhook authTokens are configured by the owner in the panel.

# Opt-in only: scheduled GET-only reconciliation runs are disabled until a trusted cron is configured.
SANDBOX_RECONCILIATION_ENABLED=false

# Fase 4 — recorrencias: sem deploy nao existe agendador automatico.
# Worker gera somente rascunhos, NUNCA emite Pix ou envia mensagens.
RECURRENCE_SCHEDULER_ENABLED=false
